<?xml version="1.0" encoding="utf-8"?>
<!-- 스프린터 벽 클라임 성공 전반부(지상, 0~30%) (B42).
     TRWallUpDone은 TimePc 0.30에 발화한다 - 애님 30% 지점에 텔레포트로 올라가고
     나머지 70%는 위층에서 재생되어 연속적으로 보인다.
     B41에서는 hitreaction 상태 중 OnZombieUpdate가 발화하지 않아(IsoZombie.java:2096
     배제 목록) 이 신호를 OnTick 감시 큐로 잡아야 했지만, B42는 그 배제 목록이
     사라져서(IsoZombie.java:3352) OnZombieUpdate가 매 틱 도는 덕분에 큐가 필요 없다.
     같은 0.30 지점의 TRWallUpTop=true가 이 노드의 조건(Top==false)을 깨고
     후반부 노드로 전환한다. End의 Started=false는 전환 실패 시 탈출 폴백. -->
<animNode>
	<m_Name>TRWallUpSuccess</m_Name>
	<m_AnimName>TR_ClimbWall_Success</m_AnimName>
	<m_ConditionPriority>1</m_ConditionPriority>
	<m_Looped>false</m_Looped>
	<m_SpeedScale>1.04</m_SpeedScale>
	<m_BlendTime>0.10</m_BlendTime>
	<m_Conditions>
		<m_Name>hitreaction</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>TRWallUpReactionSuccess</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>TRWallUpStarted</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>TRWallUpTop</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>false</m_Value>
	</m_Conditions>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>TRWallUpStarted=false</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_TimePc>0.30</m_TimePc>
		<m_ParameterValue>TRWallUpDone=true</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_TimePc>0.30</m_TimePc>
		<m_ParameterValue>TRWallUpTop=true</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>PlaySound</m_EventName>
		<m_TimePc>0.35</m_TimePc>
		<m_ParameterValue>LandHeavy</m_ParameterValue>
	</m_Events>
</animNode>
