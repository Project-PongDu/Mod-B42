<?xml version="1.0" encoding="utf-8"?>
<!-- 스프린터 높은담장 클라임 성공부 (B42). 파쿠르 실패는 0%이므로 Fail 노드는 없다.
     진행 중 관통(collidable 해제)은 Lua(psWallClimb)가 매 틱 담당한다 -
     IsoZombie.update가 OnZombieUpdate 발화 직전 setCollidable(true)를 때리므로
     Lua가 매 틱 다시 꺼주지 않으면 관통이 유지되지 않는다. -->
<animNode>
	<m_Name>TRClimbWallSuccess</m_Name>
	<m_AnimName>TR_ClimbWall_Success</m_AnimName>
	<m_ConditionPriority>1</m_ConditionPriority>
	<m_Looped>false</m_Looped>
	<m_SpeedScale>1.04</m_SpeedScale>
	<m_BlendTime>0.10</m_BlendTime>
	<m_Conditions>
		<m_Name>hitreaction</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>TRClimbWallReactionSuccess</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>TRClimbWallStarted</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>TRClimbWallStarted=false</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>PlaySound</m_EventName>
		<m_TimePc>0.35</m_TimePc>
		<m_ParameterValue>LandHeavy</m_ParameterValue>
	</m_Events>
</animNode>
