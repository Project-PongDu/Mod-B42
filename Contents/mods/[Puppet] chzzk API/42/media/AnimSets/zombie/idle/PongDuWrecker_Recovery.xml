<?xml version="1.0" encoding="utf-8"?>
<!-- 레커(돌진 특수좀비) 회복: 돌진 뒤 멈춰 선다 (shared/PongDuWrecker.lua, client/features/wrecker.lua).
     클립·노드 설정은 원본 레커(The Mutants, PZTheMutants_Wrecker_ChargeRecovery_Base)와 같다.
     조건만 원본 3개 변수 대신 퐁듀 단계 변수 PongDuWreckerPhase 하나를 쓴다.
     각 클라가 좀비에 PongDuWreckerPhase 를 세우면 좀비가 지금 어느 상태에 있든 이 노드가 덮어쓴다.
     애니메이션 변수는 네트워크로 안 가므로(ZombiePacket) 비소유 클라의 *-network 상태에도 같은 노드를 깐다.
     원본과 같은 상태 폴더에 둔다: Warn/Sprint/Recovery 는 attack, attack-network, face-target, idle, lunge,
     lunge-network, walktoward, walktoward-network / Sprint 는 bumped 도 / Sprint·Recovery 는 thump 도.
     수정 시 같은 이름 파일을 전부 같이 바꿀 것. -->
<animNode>
	<m_Name>PongDuWrecker_Recovery</m_Name>
	<m_Priority>10</m_Priority>
	<m_ConditionPriority>1000</m_ConditionPriority>
	<m_AnimName>Zombie_PZM_Wrecker_ChargeRecovery</m_AnimName>
	<m_useDeferredMovement>true</m_useDeferredMovement>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.10</m_BlendTime>
	<m_BlendOutTime>0.10</m_BlendOutTime>
	<m_StopAnimOnExit>true</m_StopAnimOnExit>
	<m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
	<m_Conditions>
		<m_Name>PongDuWreckerPhase</m_Name>
		<m_Type>STRING</m_Type>
		<m_StringValue>recovery</m_StringValue>
	</m_Conditions>
</animNode>
