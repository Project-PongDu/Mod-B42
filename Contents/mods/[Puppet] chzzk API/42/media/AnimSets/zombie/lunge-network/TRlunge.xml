<?xml version="1.0" encoding="utf-8"?>
<!-- 스프린터 런지 이속 오버라이드 (B42).
     바닐라 lunge/sprintN.xml 5종이 전부 Zombie_Sprint06 동일이라 단일 노드로 통합.
     바닐라 실효 조건은 2개(intrees + zombieWalkType)이므로 조건 수만으로는 동률이 난다.
     m_ConditionPriority=1로 확실하게 우선권을 잡는다.
     m_SpeedScale은 TracerLungeSpeed(바닐라 0.90 x 샌드박스 배율)를 읽는다. -->
<animNode>
	<m_Name>TRlunge</m_Name>
	<m_AnimName>Zombie_Sprint06</m_AnimName>
	<m_Priority>5</m_Priority>
	<m_ConditionPriority>1</m_ConditionPriority>
	<m_SpeedScale>TracerLungeSpeed</m_SpeedScale>
	<m_BlendTime>0.35</m_BlendTime>
	<m_Conditions>
		<m_Name>intrees</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>false</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>PuppetTracer</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Events>
		<m_EventName>Footstep</m_EventName>
		<m_TimePc>0.15</m_TimePc>
		<m_ParameterValue>sprint</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>Footstep</m_EventName>
		<m_TimePc>0.6</m_TimePc>
		<m_ParameterValue>sprint</m_ParameterValue>
	</m_Events>
</animNode>
