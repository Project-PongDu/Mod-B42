<?xml version="1.0" encoding="utf-8"?>
<!-- [테스트] 숄더차지 어깨빵 애니메이션 파이프라인 검증 (client/PongDuBashTest.lua).
     Lua 가 각 클라에서 좀비에 PongDuShoulderBash=true 를 세우면, 좀비가 지금 어느 상태
     (소유 클라의 walktoward/lunge/attack 이든 비소유 클라의 *-network 이든)에 있든
     이 노드가 덮어쓴다. 상태를 강제로 바꾸지 않고 상태별로 같은 노드를 깔아 두는 방식.
     클립은 자리 표시용 Bob_Shove(플레이어 밀치기). 좀비와 플레이어는 Human 클립 사전을
     공유한다(ModelManager.getAnimationClip).
     Start/End 이벤트로 PongDuBashPlayed/PongDuBashDone 을 세워 Lua 가 클라별로
     "이 노드가 실제로 재생됐는지"를 로그로 판정한다.
     우선순위 3: PongDuRainFall(2)·트레이서 TR*(1)·바닐라(0)보다 위, 바닐라 래그돌(8~10)보다 아래.
     같은 파일이 zombie/{idle,walktoward(-network),pathfind,lunge(-network),attack(-network),
     face-target,turnalerted,bumped,thump} 에 들어 있다 - 테스트 끝나면 전부 같이 지울 것. -->
<animNode>
	<m_Name>PongDuBashTest</m_Name>
	<m_AnimName>Bob_Shove</m_AnimName>
	<m_ConditionPriority>3</m_ConditionPriority>
	<m_Looped>false</m_Looped>
	<m_SpeedScale>1.00</m_SpeedScale>
	<m_BlendTime>0.10</m_BlendTime>
	<m_Conditions>
		<m_Name>PongDuShoulderBash</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>PongDuBashPlayed=true</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>PongDuBashDone=true</m_ParameterValue>
	</m_Events>
</animNode>
