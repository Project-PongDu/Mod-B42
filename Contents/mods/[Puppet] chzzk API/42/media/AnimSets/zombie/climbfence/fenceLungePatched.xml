<?xml version="1.0" encoding="utf-8"?>
<!-- 담장 런지 데미지 억제 변형 (B42). B42 바닐라 climbfence/fenceLunge.xml에서
     파생했다(B41 사본을 옮기지 않는 이유: B42는 2DBlend 배치와 요소 순서가 달라
     바닐라 기준으로 새로 파생해야 안전하다).
     바뀐 것은 셋뿐이다:
       1. NoLungeAttack==true 조건 추가
       2. m_ConditionPriority=1 (바닐라 fenceLunge를 이기기 위함)
       3. CheckAttack 이벤트 제거. ClimbOverFenceState.OnAnimEvent_CheckAttack:363이
          attackFromWindowsLunge를 호출하는 유일한 데미지 경로다. 이벤트를 빼면
          모션은 그대로고 데미지만 0이 된다.
     SetState=Attack은 남겨둔다. ParameterZombieState(오디오 파라미터)만 건드리므로
     데미지와 무관하고, 제거하면 런지 사운드가 어긋난다. -->
<animNode>
	<m_Name>TRFenceLunge</m_Name>
	<m_AnimName>Zombie_ClimbWindowLunge</m_AnimName>
	<m_ConditionPriority>1</m_ConditionPriority>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.40</m_BlendTime>
	<m_Scalar>FenceLungeX</m_Scalar>
	<m_Scalar2>FenceLungeY</m_Scalar2>
	<m_2DBlends referenceID="1">
