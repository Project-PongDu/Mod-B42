		<m_YPos>0.00</m_YPos>
		<m_SpeedScale>0.80</m_SpeedScale>
	</m_2DBlends>
	<m_2DBlends referenceID="6">
		<m_AnimName>Zombie_ClimbWindowLunge</m_AnimName>
		<m_XPos>0.00</m_XPos>
		<m_YPos>-0.04</m_YPos>
		<m_SpeedScale>0.80</m_SpeedScale>
	</m_2DBlends>
	<m_Conditions>
