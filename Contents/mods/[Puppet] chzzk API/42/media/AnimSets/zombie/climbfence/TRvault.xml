<?xml version="1.0" encoding="utf-8"?>
<!-- 스프린터 낮은담장/창문개구부 Sprint 볼트 (B42).
     바닐라 player/climbfence/vaultOverSprint.xml의 단일노드 구조를 미러링.
     핵심: ClimbFenceStarted를 절대 true로 세우지 않는다. Started=true가 되면
     ClimbOverFenceState.execute(B42 ClimbOverFenceState.java:186)의 슬라이드/클램프
     블록이 깨어나 위치를 시작칸+1타일로 강제 견인해 플레이어보다 1타일 짧게 착지한다.
     이동은 100% 루트모션에 맡기고 ClimbFenceFinished를 클립 50% 지점에 쏴서 조기 종료.
     (VaultOverSprint 조건 대신 PuppetTracer를 쓰는 이유: 좀비는 bSprinting이 안 서서
      엔진이 VaultOverSprint를 세워주지 않는다 - B42 ClimbOverFenceState.enter:88 확인)
     m_ConditionPriority=1로 바닐라 start.xml / fenceLunge.xml보다 먼저 평가된다. -->
<animNode>
	<m_Name>TRvault</m_Name>
	<m_AnimName>Bob_ValultOver_Sprint</m_AnimName>
	<m_Priority>5</m_Priority>
	<m_ConditionPriority>1</m_ConditionPriority>
	<m_Looped>false</m_Looped>
	<m_SpeedScale>0.80</m_SpeedScale>
	<m_BlendTime>0.30</m_BlendTime>
	<m_Conditions>
		<m_Name>PuppetTracer</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>ClimbFenceStarted</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>false</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>ClimbFenceOutcome</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>success</m_Value>
	</m_Conditions>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_TimePc>0.5</m_TimePc>
		<m_ParameterValue>ClimbFenceFinished=true</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>PlayFenceSound</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>ClimbOverFenceLow</m_ParameterValue>
	</m_Events>
</animNode>
